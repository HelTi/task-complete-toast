{
  "name": "@local/task-complete-toast",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Top-right task completion notice with a chime for the DeepSeek Harness web GUI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelTi/task-complete-toast.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
